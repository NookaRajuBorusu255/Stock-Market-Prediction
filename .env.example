# ──────────────────────────────────────────────────────────────────
#  EquityAI — Environment Variable Template
#  Copy this file to .env and fill in your values.
#  The .env file is loaded automatically by config.py via python-dotenv.
# ──────────────────────────────────────────────────────────────────

# ── Security ─────────────────────────────────────────────────────
# Required in production. Generate a strong key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret-key

# ── Database ─────────────────────────────────────────────────────
# Default: SQLite at instance/stock_platform.db (no change needed for local dev)
# PostgreSQL example: postgresql://user:password@localhost:5432/equityai
# DATABASE_URL=sqlite:///instance/stock_platform.db

# ── Chatbot AI API Keys (Optional) ───────────────────────────────
# Set one of these to enable generative AI chatbot responses.
# If neither is set, the chatbot uses a local rule-based NLP fallback.
#
# Google Gemini (recommended — free tier available)
# Obtain at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key-here
#
# OpenAI GPT-3.5 (fallback if Gemini key is not set)
# Obtain at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-openai-api-key-here

# ── Development ───────────────────────────────────────────────────
# Enable Werkzeug debug mode. NEVER set to true in production.
# FLASK_DEBUG=false
